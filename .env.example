# Copiá este archivo a .env para probar en local:  cp .env.example .env
# En el hosting, estas mismas variables se cargan en el panel del servicio.

# Clave de Flask (firmar cookies y mensajes). Generala con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria

# Puerto de escucha (en Render/Fly/Railway lo inyecta el hosting: no lo definas allí).
PORT=8000

# Procesos de gunicorn y hilos por proceso.
WEB_CONCURRENCY=2
GUNICORN_THREADS=4

# Solo para desarrollo local: 1 muestra el depurador de Flask.
FLASK_DEBUG=0

# Nivel de log de gunicorn: debug, info, warning, error.
LOG_LEVEL=info
